rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // User profile access
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Student roster records
    match /students/{studentId} {
      allow read: if true; // Allows students to look up their assigned code/pin or teacher to view roster
      allow create, update, delete: if request.auth != null;
    }

    // Mood Diary entries
    match /moodDiaries/{diaryId} {
      allow read: if true; // Allows student viewing their logs or teacher inspecting classroom
      allow create: if true; // Allows student to submit emotional diary (authenticated or with student ID)
      allow update: if request.auth != null; // Teachers can leave feedback notes or students update note
      allow delete: if request.auth != null;
    }
  }
}
